<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/category_card_margin"
    android:layout_marginVertical="@dimen/category_card_margin"
    app:cardCornerRadius="@dimen/category_card_corner_radius"
    app:cardElevation="0dp"
    app:cardBackgroundColor="@color/surface"
    app:strokeColor="@color/card_stroke"
    app:strokeWidth="1dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/category_card_padding">

        <View
            android:id="@+id/statusIndicator"
            android:layout_width="@dimen/category_status_indicator_width"
            android:layout_height="0dp"
            android:background="@color/status_success"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <de.hdodenhof.circleimageview.CircleImageView
            android:id="@+id/categoryIcon"
            android:layout_width="@dimen/category_icon_size"
            android:layout_height="@dimen/category_icon_size"
            android:layout_marginStart="@dimen/category_icon_margin"
            android:src="@drawable/ic_category"
            android:background="@drawable/bg_category_icon_circle"
            app:civ_border_width="2dp"
            app:civ_border_color="@color/primary"
            app:layout_constraintStart_toEndOf="@id/statusIndicator"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            tools:src="@drawable/ic_category" />

        <TextView
            android:id="@+id/categoryName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/category_content_margin"
            android:layout_marginEnd="@dimen/category_content_margin"
            android:text="Category Name"
            android:textAppearance="@style/TextAppearance.MaterialComponents.Headline6"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/category_name_size"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end"
            app:layout_constraintStart_toEndOf="@id/categoryIcon"
            app:layout_constraintTop_toTopOf="@id/categoryIcon"
            app:layout_constraintEnd_toStartOf="@id/editButton"
            tools:text="Category Name" />

        <TextView
            android:id="@+id/categoryType"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/category_type_margin"
            android:background="@drawable/bg_category_type_chip"
            android:paddingHorizontal="@dimen/category_type_chip_padding"
            android:paddingVertical="@dimen/spacing_tiny"
            android:text="SAVINGS"
            android:textAppearance="@style/TextAppearance.MaterialComponents.Caption"
            android:textColor="@color/primary"
            android:textSize="@dimen/category_type_size"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="@id/categoryName"
            app:layout_constraintTop_toBottomOf="@id/categoryName"
            tools:text="SAVINGS" />

        <TextView
            android:id="@+id/categoryDescription"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/category_description_margin"
            android:layout_marginEnd="@dimen/category_content_margin"
            android:text="Category description goes here"
            android:textAppearance="@style/TextAppearance.MaterialComponents.Body2"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/category_description_size"
            android:maxLines="2"
            android:ellipsize="end"
            app:layout_constraintEnd_toEndOf="@id/categoryName"
            app:layout_constraintStart_toStartOf="@id/categoryName"
            app:layout_constraintTop_toBottomOf="@id/categoryType"
            tools:text="Category description goes here" />

        <LinearLayout
            android:id="@+id/budgetInfoLayout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/category_budget_margin"
            android:layout_marginEnd="@dimen/category_content_margin"
            android:orientation="horizontal"
            app:layout_constraintStart_toStartOf="@id/categoryName"
            app:layout_constraintEnd_toEndOf="@id/categoryName"
            app:layout_constraintTop_toBottomOf="@id/categoryDescription">

            <TextView
                android:id="@+id/categoryMinBudget"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Min: R0.00"
                android:textAppearance="@style/TextAppearance.MaterialComponents.Body2"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/category_budget_size" />

            <TextView
                android:id="@+id/categoryMaxBudget"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Max: R0.00"
                android:textAppearance="@style/TextAppearance.MaterialComponents.Body2"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/category_budget_size" />

        </LinearLayout>

        <ImageButton
            android:id="@+id/editButton"
            android:layout_width="@dimen/category_button_size"
            android:layout_height="@dimen/category_button_size"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Edit Category"
            android:padding="@dimen/category_button_padding"
            android:src="@drawable/ic_edit"
            app:layout_constraintEnd_toStartOf="@id/deleteButton"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:tint="@color/primary" />

        <ImageButton
            android:id="@+id/deleteButton"
            android:layout_width="@dimen/category_button_size"
            android:layout_height="@dimen/category_button_size"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Delete Category"
            android:padding="@dimen/category_button_padding"
            android:src="@drawable/ic_delete"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:tint="@color/red" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>
