<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="@dimen/spacing_medium">

    <!-- Enhanced Accounts Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="@dimen/spacing_medium">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="@dimen/icon_size_large"
            android:layout_height="@dimen/icon_size_large"
            app:cardCornerRadius="12dp"
            app:cardBackgroundColor="@color/primary"
            app:cardElevation="6dp"
            android:background="@drawable/icon_glow_background">

            <ImageView
                android:layout_width="@dimen/icon_size_medium"
                android:layout_height="@dimen/icon_size_medium"
                android:layout_gravity="center"
                android:src="@drawable/ic_accounts"
                app:tint="@color/white" />
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="@dimen/spacing_medium">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Your Accounts"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_title_medium"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.02" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Manage your finances"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_body_medium"
                android:layout_marginTop="2dp"
                android:fontFamily="sans-serif-light" />
        </LinearLayout>
    </LinearLayout>

    <!-- Enhanced Accounts List Container -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginBottom="@dimen/spacing_medium"
        app:cardCornerRadius="16dp"
        app:cardBackgroundColor="@color/primary"
        app:cardElevation="8dp"
        app:strokeWidth="1dp"
        app:strokeColor="@color/primary">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="@dimen/spacing_medium">

            <!-- Enhanced Accounts Summary -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="@dimen/spacing_medium">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="@dimen/spacing_small"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="4dp"
                    app:cardBackgroundColor="@color/primary_dark"
                    app:strokeWidth="1dp"
                    app:strokeColor="@color/primary">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/spacing_medium"
                        android:gravity="center">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Total Balance"
                            android:textColor="@color/white"
                            android:textSize="@dimen/text_body_small"
                            android:alpha="0.9"
                            android:fontFamily="sans-serif-light" />

                        <TextView
                            android:id="@+id/totalBalanceText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="R0"
                            android:textColor="@color/white"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:layout_marginTop="4dp"
                            android:fontFamily="sans-serif-medium" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/spacing_small"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="4dp"
                    app:cardBackgroundColor="@color/secondary"
                    app:strokeWidth="1dp"
                    app:strokeColor="@color/secondary">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/spacing_medium"
                        android:gravity="center">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Accounts"
                            android:textColor="@color/white"
                            android:textSize="@dimen/text_body_small"
                            android:alpha="0.9"
                            android:fontFamily="sans-serif-light" />

                        <TextView
                            android:id="@+id/accountsCountText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textColor="@color/white"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:layout_marginTop="4dp"
                            android:fontFamily="sans-serif-medium" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- Enhanced Accounts RecyclerView with proper constraints -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/dashboardAccountsRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="true"
                android:background="@android:color/transparent"
                android:contentDescription="Dashboard accounts list"
                android:importantForAccessibility="yes"
                android:scrollbars="horizontal" />

            <!-- Enhanced Empty State with reduced padding -->
            <LinearLayout
                android:id="@+id/emptyAccountsState"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="@dimen/spacing_large"
                android:visibility="gone">

                <ImageView
                    android:layout_width="@dimen/icon_size_large"
                    android:layout_height="@dimen/icon_size_large"
                    android:src="@drawable/ic_accounts"
                    app:tint="@color/white"
                    android:alpha="0.6"
                    android:layout_marginBottom="@dimen/spacing_medium" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="No accounts yet"
                    android:textColor="@color/white"
                    android:textSize="@dimen/text_body_large"
                    android:textStyle="bold"
                    android:layout_marginBottom="@dimen/spacing_small"
                    android:fontFamily="sans-serif-medium" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Add your first account to get started"
                    android:textColor="@color/white"
                    android:textSize="@dimen/text_body_medium"
                    android:alpha="0.8"
                    android:gravity="center"
                    android:fontFamily="sans-serif-light" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Enhanced Add Account Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/addAccountButton"
        android:layout_width="match_parent"
        android:layout_height="@dimen/button_height"
        android:text="Add Account"
        android:textSize="@dimen/text_body_large"
        android:layout_marginTop="@dimen/spacing_small"
        app:backgroundTint="@color/primary"
        android:textColor="@color/white"
        app:cornerRadius="12dp"
        app:elevation="6dp"
        android:fontFamily="sans-serif-medium" />

    <!-- Enhanced Quick Actions -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="@dimen/spacing_medium">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/viewAllAccountsButton"
            android:layout_width="0dp"
            android:layout_height="@dimen/button_height_small"
            android:layout_weight="1"
            android:text="View All"
            android:textSize="@dimen/text_body_medium"
            android:padding="@dimen/spacing_small"
            app:backgroundTint="@color/surface"
            android:textColor="@color/primary"
            app:cornerRadius="10dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/primary"
            android:layout_marginEnd="@dimen/spacing_small"
            android:fontFamily="sans-serif-medium" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/transferButton"
            android:layout_width="0dp"
            android:layout_height="@dimen/button_height_small"
            android:layout_weight="1"
            android:text="Transfer"
            android:textSize="@dimen/text_body_medium"
            android:padding="@dimen/spacing_small"
            app:backgroundTint="@color/primary"
            android:textColor="@color/white"
            app:cornerRadius="10dp"
            app:elevation="4dp"
            android:layout_marginStart="@dimen/spacing_small"
            android:fontFamily="sans-serif-medium" />
    </LinearLayout>

</LinearLayout> 